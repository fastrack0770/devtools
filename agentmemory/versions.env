# Единственный источник версий стека. Читается deploy/agentmemory.sh и
# копируется в сгенерированный ~/llm/.env, откуда его берут compose и
# сборка образа. Одно значение — одно место.
#
# AGENTMEMORY_VERSION обязано совпадать в двух местах сразу: пакет внутри
# контейнера (воркер памяти) и глобальный npm-пакет на хосте (из него
# берутся hook-скрипты, на которые хуки Claude и Codex ссылаются
# абсолютными путями). Установщик приводит хост к этому значению.
AGENTMEMORY_VERSION=0.9.29

# Пин движка. 0.11.6 ломает текущую worker-модель agentmemory — подробности
# в комментарии к сервису iii-engine. Смена этого числа поверх накопленной
# памяти = миграция данных, а не апгрейд образа: см. docs/adr/0005.
III_VERSION=0.11.2

# Имя модели разом для трёх мест: --hf-repo и --alias у llama-server,
# OPENAI_MODEL у контейнера agentmemory и OPENAI_MODEL в ~/.agentmemory/.env
# (его читает хостовой CLI). Не совпадут — /v1/models отдаст не то имя,
# которое спрашивает клиент, и запросы к LLM будут падать.
LLM_MODEL=Qwen/Qwen3-4B-GGUF:Q4_K_M
